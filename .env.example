# Copy to .env.local and fill in real values. .env.local is gitignored.

# Prisma Postgres, provisioned via the Vercel dashboard (Storage tab ->
# Create Database -> Prisma Postgres). Pooled connection used at runtime;
# DIRECT_URL (unpooled) is used for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Auth.js session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Used once by `npx prisma db seed` to create the one admin account.
# Not needed after the account exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Cloudflare Turnstile (contact form spam protection). Get both from the
# Cloudflare dashboard -> Turnstile -> Add site. The site key is public
# (shipped to the browser); the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Google Analytics 4 (site visit tracking). Get this from the GA4 admin ->
# Data Streams -> your web stream -> Measurement ID (format: G-XXXXXXXXXX).
# Only loads after a visitor accepts the cookie-consent banner on the public
# site; left blank, the banner and GA script simply don't render.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
