# Copy to .env.local and fill in real values. .env.local is gitignored.

# Prisma Postgres, provisioned via the Vercel dashboard (Storage tab ->
# Create Database -> Prisma Postgres). Pooled connection used at runtime;
# DIRECT_URL (unpooled) is used for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Auth.js session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Used once by `npx prisma db seed` to create the one admin account.
# Not needed after the account exists.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
